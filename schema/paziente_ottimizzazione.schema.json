{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "paziente_ottimizzazione.schema.json",
    "title": "Campi di ottimizzazione del paziente",
    "type": "object",
    "required": ["modello_ottimizzazione"],
    "properties": {
        "modello_ottimizzazione": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "versione_schema",
                "categoria_paper",
                "attesa_massima_giorni",
                "specializzandi_abilitati"
            ],
            "properties": {
                "versione_schema": {"const": 1},
                "categoria_paper": {"enum": ["I'", "I''", "I'''"]},
                "attesa_massima_giorni": {
                    "type": ["integer", "null"],
                    "description": "Null per dati ancora da classificare. Il planner richiede un intero positivo per la categoria I'.",
                    "minimum": 1
                },
                "specializzandi_abilitati": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "uniqueItems": true
                }
            }
        }
    },
    "additionalProperties": true
}
